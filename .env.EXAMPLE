# Copy this file to .env and edit the values before starting the stack.

# Domain handled by Cloudflare DNS, for example: example.com
DOMAIN=example.com

# Service hostnames
TRAEFIK_HOST=traefik.example.com
FILEBROWSER_HOST=files.example.com
PORTAINER_HOST=portainer.example.com
QBITTORRENT_HOST=qbittorrent.example.com
PLEX_HOST=plex.example.com
SONARR_HOST=sonarr.example.com
RADARR_HOST=radarr.example.com
WHOAMI_HOST=whoami.example.com

# Linux user/group IDs used by linuxserver.io containers.
# Run: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/Budapest

# Host paths
APPDATA_PATH=/mnt/appdata
PLEX_MEDIA_PATH=/mnt/plex-media
DOWNLOADS_PATH=/mnt/appdata/downloads

# Optional Plex claim token for first setup.
# Get one from https://www.plex.tv/claim/ and start the stack shortly after.
PLEX_CLAIM=

# Traefik dashboard basic auth.
# Generate with:
#   htpasswd -nbB admin 'change-this-password' | sed -e 's/\\$/\\$\\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$replace-this-with-a-real-bcrypt-hash

# Cloudflare Tunnel
# Create this before starting with: ./scripts/cloudflare-tunnel-create.sh
CLOUDFLARE_TUNNEL_NAME=home-server
CLOUDFLARE_TUNNEL_ID=replace-with-tunnel-id
